<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#2c7a4b">
    <title>نظام المخازن - شركة جميل الحطامي</title>
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-auth-compat.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        /* أنماط التصميم الاحترافية */
        *{margin:0;padding:0;box-sizing:border-box}
        body{font-family:'Cairo',sans-serif;background:#eef2f5;padding:20px;direction:rtl}
        .container{max-width:1400px;margin:0 auto}
        .header{background:linear-gradient(135deg,#1e3a2f,#2c7a4b);color:white;padding:20px;border-radius:20px;margin-bottom:20px;text-align:center}
        .badge{background:#2c7a4b;color:white;padding:4px 12px;border-radius:30px;font-size:12px;display:inline-block}
        .cloud-badge{background:#3498db;color:white;padding:4px 12px;border-radius:30px;font-size:12px;display:inline-block;margin-right:10px}
        .auth-card{background:white;border-radius:20px;padding:20px;margin-bottom:20px;text-align:center}
        .auth-input{padding:12px;margin:8px;border-radius:30px;border:1px solid #ddd;width:200px;font-family:'Cairo'}
        .btn{padding:10px 24px;border-radius:30px;border:none;cursor:pointer;font-family:'Cairo';font-weight:bold;transition:.2s;margin:4px}
        .btn-primary{background:#2c7a4b;color:white}.btn-primary:hover{background:#1e5a3a}
        .btn-danger{background:#dc2626;color:white}.btn-info{background:#3498db;color:white}
        .sync-status{background:#e7f0ec;padding:8px 16px;border-radius:30px;font-size:12px;display:inline-block;margin-bottom:16px}
        .main-grid{display:grid;grid-template-columns:1fr 340px;gap:20px}
        @media(max-width:800px){.main-grid{grid-template-columns:1fr}}
        .card{background:white;border-radius:20px;padding:20px;margin-bottom:20px;box-shadow:0 2px 8px rgba(0,0,0,.08)}
        .card-title{font-size:18px;font-weight:700;margin-bottom:16px;border-right:3px solid #2c7a4b;padding-right:12px}
        .table-container{overflow-x:auto;max-height:400px;overflow-y:auto}
        table{width:100%;border-collapse:collapse}
        th,td{padding:10px;border-bottom:1px solid #ddd;text-align:center}
        th{background:#e7f0ec;position:sticky;top:0}
        .low-stock-warning{background:#fff3cd;color:#856404}
        .kpi-row{display:flex;gap:16px;margin-bottom:20px;flex-wrap:wrap}
        .kpi{background:white;border-radius:16px;padding:12px 20px;flex:1;text-align:center}
        .kpi-value{font-size:24px;font-weight:800;color:#1e3a2f}
        .toast-container{position:fixed;bottom:20px;right:20px;z-index:1000;display:flex;flex-direction:column;gap:10px}
        .toast{background:#2c7a4b;color:white;padding:12px 24px;border-radius:40px;font-size:14px;animation:slideIn .3s ease}
        @keyframes slideIn{from{transform:translateX(100px);opacity:0}to{transform:translateX(0);opacity:1}}
        .activity-list{max-height:200px;overflow-y:auto}
        .activity-item{padding:8px;border-bottom:1px solid #eee;font-size:12px}
    </style>
</head>
<body>
<div class="container">
    <div class="header">
        <h2>☁️ نظام إدارة المخازن - شركة جميل الحطامي</h2>
        <p>سحابي | متعدد الأجهزة | مزامنة فورية</p>
        <span class="badge">✅ نظام متكامل</span>
        <span class="cloud-badge">🌐 يعمل على الإنترنت</span>
    </div>
    <div class="auth-card" id="authSection">
        <h3>🔐 تسجيل الدخول</h3>
        <input type="email" id="loginEmail" class="auth-input" placeholder="البريد الإلكتروني">
        <input type="password" id="loginPassword" class="auth-input" placeholder="كلمة المرور">
        <button id="loginBtn" class="btn btn-primary">🚀 دخول</button>
        <button id="signupBtn" class="btn btn-info">📝 إنشاء حساب</button>
    </div>
    <div id="mainApp" style="display:none">
        <div class="sync-status" id="syncStatus">🌐 متصل بالسحابة</div>
        <div class="kpi-row">
            <div class="kpi"><div class="kpi-value" id="totalItems">0</div><div class="kpi-label">إجمالي الأصناف</div></div>
            <div class="kpi"><div class="kpi-value" id="lowStockCount">0</div><div class="kpi-label">⚠️ أصناف منخفضة</div></div>
            <div class="kpi"><div class="kpi-value" id="totalQuantity">0</div><div class="kpi-label">إجمالي الكميات</div></div>
        </div>
        <div class="main-grid">
            <div>
                <div class="card">
                    <div class="card-title">📋 المخزون الحالي</div>
                    <div class="table-container">
                        <table id="inventoryTable"><thead><tr><th>#</th><th>رقم الصنف</th><th>اسم الصنف</th><th>الوحدة</th><th>الكمية</th><th>المشرف</th><th>تعديل</th></tr></thead><tbody id="tableBody"></tbody></table>
                    </div>
                </div>
            </div>
            <div>
                <div class="card">
                    <div class="card-title">🔄 النشاط الحي</div>
                    <div class="activity-list" id="activityList"><div style="padding:12px;text-align:center">⚡ انتظار أول تعديل...</div></div>
                    <div style="margin-top:16px"><button id="logoutBtn" class="btn btn-danger">🚪 تسجيل خروج</button></div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="toast-container" id="toastContainer"></div>
<script>
    // إعدادات Firebase النهائية والمؤكدة
    const firebaseConfig = {
        apiKey: "AIzaSyCND4k2bj3KAS_kWOH8KOdydzd2WSl2CjY",
        authDomain: "jamil-al-hattami-company.firebaseapp.com",
        projectId: "jamil-al-hattami-company",
        storageBucket: "jamil-al-hattami-company.firebasestorage.app",
        messagingSenderId: "645526786969",
        appId: "1:645526786969:web:325b9fb924100610113908"
    };
    
    // تهيئة Firebase
    firebase.initializeApp(firebaseConfig);
    const db = firebase.firestore();
    const auth = firebase.auth();
    
    let inventoryData = [ /* بياناتك الأولية */ ];
    let currentUser = null;
    let activityLog = [];
    const LOW_STOCK_THRESHOLD = 20;
    
    /* باقي دوال النظام (showToast, updateKPIs, renderInventory, addActivity, syncToCloud, loadFromCloud, handleLogin, handleSignup, handleLogout) */
    // دوال العرض والتعديل والتزامن مع السحابة
    
    function showToast(m){ const c=document.getElementById('toastContainer'); const t=document.createElement('div'); t.className='toast'; t.innerHTML=m; c.appendChild(t); setTimeout(()=>t.remove(),3000); }
    function updateKPIs(){ document.getElementById('totalItems').innerText=inventoryData.length; document.getElementById('lowStockCount').innerText=inventoryData.filter(i=>i.quantity<LOW_STOCK_THRESHOLD).length; document.getElementById('totalQuantity').innerText=inventoryData.reduce((s,i)=>s+(Number(i.quantity)||0),0); }
    function renderInventory(){ const tbody=document.getElementById('tableBody'); tbody.innerHTML=''; inventoryData.forEach((item,idx)=>{ const row=tbody.insertRow(); const isLow=item.quantity<LOW_STOCK_THRESHOLD; row.className=isLow?'low-stock-warning':''; row.insertCell(0).innerText=idx+1; row.insertCell(1).innerText=item.code; row.insertCell(2).innerText=item.name; row.insertCell(3).innerText=item.unit; row.insertCell(4).innerHTML=`<strong>${item.quantity}</strong>`; row.insertCell(5).innerText=item.supervisor||'-'; const editCell=row.insertCell(6); const btn=document.createElement('button'); btn.innerHTML='✏️ تعديل'; btn.style.padding='4px 12px'; btn.style.borderRadius='20px'; btn.style.border='none'; btn.style.cursor='pointer'; btn.style.background='#e7f0ec'; btn.onclick=async()=>{ const q=prompt(`تعديل كمية "${item.name}"`,item.quantity); if(q!==null&&!isNaN(Number(q))){ item.quantity=Number(q); await syncToCloud(); renderInventory(); updateKPIs(); addActivity('تعديل كمية',`${item.name} → ${item.quantity}`); showToast('✅ تم التعديل والمزامنة'); } }; editCell.appendChild(btn); }); updateKPIs(); }
    function addActivity(a,d){ activityLog.unshift({id:Date.now(),timestamp:new Date().toISOString(),action:a,details:d}); if(activityLog.length>20) activityLog.pop(); const c=document.getElementById('activityList'); if(activityLog.length===0){ c.innerHTML='<div style="padding:12px;text-align:center">⚡ انتظار أول تعديل...</div>'; return; } c.innerHTML=activityLog.map(a=>`<div class="activity-item"><div style="font-size:10px;color:#6b7280">${new Date(a.timestamp).toLocaleString()}</div><div><strong>${a.action}</strong><br>${a.details}</div></div>`).join(''); }
    async function syncToCloud(){ if(!currentUser) return; try{ await db.collection('users').doc(currentUser.uid).set({ inventory:inventoryData, lastSync:firebase.firestore.FieldValue.serverTimestamp() },{merge:true}); document.getElementById('syncStatus').innerHTML='✅ متزامن مع السحابة'; setTimeout(()=>document.getElementById('syncStatus').innerHTML='🌐 متصل بالسحابة',2000); }catch(e){ showToast('❌ خطأ في المزامنة'); } }
    async function loadFromCloud(){ if(!currentUser) return; try{ const doc=await db.collection('users').doc(currentUser.uid).get(); if(doc.exists&&doc.data().inventory) inventoryData=doc.data().inventory; else await syncToCloud(); renderInventory(); }catch(e){ showToast('⚠️ لا يمكن الاتصال بالسحابة'); } }
    async function handleLogin(){ const e=document.getElementById('loginEmail').value.trim(); const p=document.getElementById('loginPassword').value.trim(); if(!e||!p){ showToast('❌ الرجاء إدخال البريد وكلمة المرور'); return; } try{ const r=await auth.signInWithEmailAndPassword(e,p); currentUser=r.user; document.getElementById('authSection').style.display='none'; document.getElementById('mainApp').style.display='block'; await loadFromCloud(); addActivity('تسجيل دخول',currentUser.email); showToast(`✅ مرحباً ${currentUser.email}`); }catch(e){ showToast('❌ خطأ في تسجيل الدخول'); } }
    async function handleSignup(){ const e=document.getElementById('loginEmail').value.trim(); const p=document.getElementById('loginPassword').value.trim(); if(!e||!p||p.length<6){ showToast('❌ كلمة المرور يجب أن تكون 6 أحرف على الأقل'); return; } try{ const r=await auth.createUserWithEmailAndPassword(e,p); currentUser=r.user; await syncToCloud(); document.getElementById('authSection').style.display='none'; document.getElementById('mainApp').style.display='block'; addActivity('إنشاء حساب',currentUser.email); showToast(`✅ تم إنشاء حساب ${currentUser.email}`); }catch(e){ showToast('❌ خطأ في إنشاء الحساب'); } }
    function handleLogout(){ auth.signOut(); currentUser=null; document.getElementById('authSection').style.display='block'; document.getElementById('mainApp').style.display='none'; showToast('👋 تم تسجيل الخروج'); }
    
    document.getElementById('loginBtn').onclick=handleLogin;
    document.getElementById('signupBtn').onclick=handleSignup;
    document.getElementById('logoutBtn').onclick=handleLogout;
    
    auth.onAuthStateChanged(async(user)=>{ if(user){ currentUser=user; document.getElementById('authSection').style.display='none'; document.getElementById('mainApp').style.display='block'; await loadFromCloud(); }else{ document.getElementById('authSection').style.display='block'; document.getElementById('mainApp').style.display='none'; } });
    
    // تعريف البيانات الأولية بعد الدوال
    inventoryData = [ { id: 1, code: "002-2001", name: "أرز بسمتي", unit: "كيلو", quantity: 10, supervisor: "مدير المخزن" }, { id: 2, code: "002-2002", name: "زيت دوار الشمس", unit: "لتر", quantity: 30, supervisor: "" }, { id: 3, code: "002-2003", name: "سكر أبيض", unit: "كيلو", quantity: 5, supervisor: "مدير المخزن" }, { id: 4, code: "002-2004", name: "حليب بودرة", unit: "علبة", quantity: 15, supervisor: "" }, { id: 5, code: "002-2005", name: "عدس مجروش", unit: "كيلو", quantity: 25, supervisor: "مسؤول مشتريات" } ];
</script>
