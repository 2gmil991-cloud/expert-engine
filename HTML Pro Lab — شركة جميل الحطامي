<script>
    // ⚠️ IMPORTANT: استبدل هذه القيم بإعدادات Firebase من مشروعك ⚠️
    const firebaseConfig = {
        apiKey: "YOUR_API_KEY",
        authDomain: "YOUR_AUTH_DOMAIN",
        projectId: "YOUR_PROJECT_ID",
        storageBucket: "YOUR_STORAGE_BUCKET",
        messagingSenderId: "YOUR_SENDER_ID",
        appId: "YOUR_APP_ID"
    };
    
    // تهيئة Firebase
    firebase.initializeApp(firebaseConfig);
    const db = firebase.firestore();
    const auth = firebase.auth();
    
    let inventoryData = [
        { id: 1, code: "002-2001", name: "أرز بسمتي", unit: "كيلو", quantity: 10, supervisor: "مدير المخزن" },
        { id: 2, code: "002-2002", name: "زيت دوار الشمس", unit: "لتر", quantity: 30, supervisor: "" },
        { id: 3, code: "002-2003", name: "سكر أبيض", unit: "كيلو", quantity: 5, supervisor: "مدير المخزن" },
        { id: 4, code: "002-2004", name: "حليب بودرة", unit: "علبة", quantity: 15, supervisor: "" },
        { id: 5, code: "002-2005", name: "عدس مجروش", unit: "كيلو", quantity: 25, supervisor: "مسؤول مشتريات" }
    ];
    
    let currentUser = null;
    let activityLog = [];
    const LOW_STOCK_THRESHOLD = 20;
    
    function showToast(m){
        const c=document.getElementById('toastContainer');
        const t=document.createElement('div');
        t.className='toast';
        t.innerHTML=m;
        c.appendChild(t);
        setTimeout(()=>t.remove(),3000);
    }
    
    function updateKPIs(){
        document.getElementById('totalItems').innerText=inventoryData.length;
        document.getElementById('lowStockCount').innerText=inventoryData.filter(i=>i.quantity<LOW_STOCK_THRESHOLD).length;
        document.getElementById('totalQuantity').innerText=inventoryData.reduce((s,i)=>s+(Number(i.quantity)||0),0);
    }
    
    function renderInventory(){
        const tbody=document.getElementById('tableBody');
        tbody.innerHTML='';
        inventoryData.forEach((item,idx)=>{
            const row=tbody.insertRow();
            const isLow=item.quantity<LOW_STOCK_THRESHOLD;
            row.className=isLow?'low-stock-warning':'';
            row.insertCell(0).innerText=idx+1;
            row.insertCell(1).innerText=item.code;
            row.insertCell(2).innerText=item.name;
            row.insertCell(3).innerText=item.unit;
            row.insertCell(4).innerHTML=`<strong>${item.quantity}</strong>`;
            row.insertCell(5).innerText=item.supervisor||'-';
            const editCell=row.insertCell(6);
            const btn=document.createElement('button');
            btn.innerHTML='✏️ تعديل';
            btn.style.padding='4px 12px';
            btn.style.borderRadius='20px';
            btn.style.border='none';
            btn.style.cursor='pointer';
            btn.style.background='#e7f0ec';
            btn.onclick=async()=>{
                const q=prompt(`تعديل كمية "${item.name}"`,item.quantity);
                if(q!==null&&!isNaN(Number(q))){
                    item.quantity=Number(q);
                    await syncToCloud();
                    renderInventory();
                    updateKPIs();
                    addActivity('تعديل كمية',`${item.name} → ${item.quantity}`);
                    showToast('✅ تم التعديل والمزامنة');
                }
            };
            editCell.appendChild(btn);
        });
        updateKPIs();
    }
    
    function addActivity(a,d){
        activityLog.unshift({id:Date.now(),timestamp:new Date().toISOString(),action:a,details:d});
        if(activityLog.length>20) activityLog.pop();
        const c=document.getElementById('activityList');
        if(activityLog.length===0){
            c.innerHTML='<div style="padding:12px;text-align:center">⚡ انتظار أول تعديل...</div>';
            return;
        }
        c.innerHTML=activityLog.map(a=>`<div class="activity-item"><div style="font-size:10px;color:#6b7280">${new Date(a.timestamp).toLocaleString()}</div><div><strong>${a.action}</strong><br>${a.details}</div></div>`).join('');
    }
    
    async function syncToCloud(){
        if(!currentUser) return;
        try{
            await db.collection('users').doc(currentUser.uid).set({
                inventory:inventoryData,
                lastSync:firebase.firestore.FieldValue.serverTimestamp()
            },{merge:true});
            document.getElementById('syncStatus').innerHTML='✅ متزامن مع السحابة';
            setTimeout(()=>document.getElementById('syncStatus').innerHTML='🌐 متصل بالسحابة',2000);
        }catch(e){
            showToast('❌ خطأ في المزامنة');
        }
    }
    
    async function loadFromCloud(){
        if(!currentUser) return;
        try{
            const doc=await db.collection('users').doc(currentUser.uid).get();
            if(doc.exists&&doc.data().inventory) inventoryData=doc.data().inventory;
            else await syncToCloud();
            renderInventory();
        }catch(e){
            showToast('⚠️ لا يمكن الاتصال بالسحابة');
        }
    }
    
    async function handleLogin(){
        const e=document.getElementById('loginEmail').value.trim();
        const p=document.getElementById('loginPassword').value.trim();
        if(!e||!p){ showToast('❌ الرجاء إدخال البريد وكلمة المرور'); return; }
        try{
            const r=await auth.signInWithEmailAndPassword(e,p);
            currentUser=r.user;
            document.getElementById('authSection').style.display='none';
            document.getElementById('mainApp').style.display='block';
            await loadFromCloud();
            addActivity('تسجيل دخول',currentUser.email);
            showToast(`✅ مرحباً ${currentUser.email}`);
        }catch(e){
            showToast('❌ خطأ في تسجيل الدخول');
        }
    }
    
    async function handleSignup(){
        const e=document.getElementById('loginEmail').value.trim();
        const p=document.getElementById('loginPassword').value.trim();
        if(!e||!p||p.length<6){ showToast('❌ كلمة المرور يجب أن تكون 6 أحرف على الأقل'); return; }
        try{
            const r=await auth.createUserWithEmailAndPassword(e,p);
            currentUser=r.user;
            await syncToCloud();
            document.getElementById('authSection').style.display='none';
            document.getElementById('mainApp').style.display='block';
            addActivity('إنشاء حساب',currentUser.email);
            showToast(`✅ تم إنشاء حساب ${currentUser.email}`);
        }catch(e){
            showToast('❌ خطأ في إنشاء الحساب');
        }
    }
    
    function handleLogout(){
        auth.signOut();
        currentUser=null;
        document.getElementById('authSection').style.display='block';
        document.getElementById('mainApp').style.display='none';
        showToast('👋 تم تسجيل الخروج');
    }
    
    document.getElementById('loginBtn').onclick=handleLogin;
    document.getElementById('signupBtn').onclick=handleSignup;
    document.getElementById('logoutBtn').onclick=handleLogout;
    
    auth.onAuthStateChanged(async(user)=>{
        if(user){
            currentUser=user;
            document.getElementById('authSection').style.display='none';
            document.getElementById('mainApp').style.display='block';
            await loadFromCloud();
        }else{
            document.getElementById('authSection').style.display='block';
            document.getElementById('mainApp').style.display='none';
        }
    });
</script>
</body>
